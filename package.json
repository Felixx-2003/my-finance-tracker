{
  "name": "myfinance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:cloud": "prisma generate --schema prisma/cloud/schema.prisma && next build",
    "db:cloud:push": "prisma db push --schema prisma/cloud/schema.prisma",
    "db:cloud:import": "node scripts/import-local-to-cloud.mjs --apply",
    "db:cloud:verify": "node scripts/verify-cloud-import.mjs",
    "start": "next start -H 127.0.0.1",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "node scripts/generate.mjs",
    "db:setup": "npm run db:migrate && npm run db:generate && npm run db:seed",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "test:reset": "node scripts/test-reset.mjs"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "playwright-core": "^1.63.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
